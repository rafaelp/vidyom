{
  "id": "public-library-on-updated",
  "name": "Public Library On Update",
  "version": "1.0.0",
  "description": "Rebuild public.db when a publication changes, so a visibility drop removes it and a metadata change reaches it (R15, I159).",
  "trigger": {
    "type": "event",
    "event": "publication.updated"
  },
  "nodes": [
    {
      "id": "sync",
      "type": "catalog.public.sync",
      "typeVersion": 1,
      "parameters": {
        "assetId": "${event.asset_id}"
      }
    }
  ],
  "settings": {
    "retry": 3,
    "retryBackoffSeconds": 10
  },
  "outputs": {
    "records": "${nodes.sync.output.records}",
    "sha256": "${nodes.sync.output.sha256}"
  }
}
