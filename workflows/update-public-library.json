{
  "id": "update-public-library",
  "name": "Update Public Library",
  "version": "1.0.0",
  "description": "Rebuild public.db when a publication goes public (§8.2).",
  "trigger": {
    "type": "event",
    "event": "publication.completed",
    "filter": "event.payload.visibility == 'public'"
  },
  "nodes": [
    {
      "id": "sync",
      "type": "catalog.public.sync",
      "typeVersion": 1,
      "parameters": {
        "assetId": "${event.asset_id}"
      }
    }
  ],
  "settings": {
    "retry": 3,
    "retryBackoffSeconds": 10
  },
  "outputs": {
    "records": "${nodes.sync.output.records}",
    "sha256": "${nodes.sync.output.sha256}"
  }
}
