{
  "id": "purge-archive-object",
  "name": "Purge One Archive Object",
  "version": "1.0.0",
  "description": "Delete one archive object of a deleted asset. Used by purge-deleted-archives.",
  "inputs": {
    "item": {
      "type": "object",
      "required": true,
      "description": "An item of catalog.list_purgeable_archives."
    }
  },
  "nodes": [
    {
      "id": "delete_archive",
      "type": "storage.delete",
      "typeVersion": 1,
      "parameters": {
        "source": "${inputs.item.archive_uri}"
      }
    }
  ],
  "settings": {
    "retry": 2,
    "retryBackoffSeconds": 30
  }
}
