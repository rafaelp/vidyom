# Copy to .env.local. All values are read at request time.

# Path of the tenant's public.db. Use an absolute path outside `npm start`.
VIDYOM_PUBLIC_DB=data/fixture/public.db

# Site identity.
VIDYOM_LIBRARY_TITLE=Acme video library
VIDYOM_LIBRARY_DESCRIPTION=
# Absolute origin for canonical URLs and the sitemap. Leave empty to omit them.
VIDYOM_LIBRARY_SITE_URL=https://media.example.internal

# Semantic search. `off` forces lexical.
VIDYOM_LIBRARY_SEMANTIC=on
VIDYOM_LIBRARY_MAX_VECTORS=50000

# Optional query embedder: a Python AI worker on this host, never the daemon.
# Set one of SOCKET or TCP. TOKEN is required on TCP by the worker's protocol.
VIDYOM_LIBRARY_AI_WORKER_SOCKET=
VIDYOM_LIBRARY_AI_WORKER_TCP=
VIDYOM_LIBRARY_AI_WORKER_TOKEN=
VIDYOM_LIBRARY_EMBED_TIMEOUT_MS=5000
VIDYOM_LIBRARY_MIN_SIMILARITY=0.3
