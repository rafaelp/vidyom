{
  "publishing": {
    "destinations": {
      "mock-main": {
        "driver": "mock",
        "visibility": "public",
        "parameters": {
          "stateDir": "@ROOT@/mock"
        }
      },
      "mock-flaky": {
        "driver": "mock",
        "visibility": "public",
        "parameters": {
          "stateDir": "@ROOT@/mock",
          "inject": {
            "outcome_unknown": 1
          }
        }
      },
      "mock-reject": {
        "driver": "mock",
        "visibility": "public",
        "parameters": {
          "stateDir": "@ROOT@/mock",
          "inject": {
            "reject": 1
          }
        }
      },
      "mock-unknown": {
        "driver": "mock",
        "visibility": "public",
        "parameters": {
          "stateDir": "@ROOT@/mock",
          "reconcile": false,
          "inject": {
            "outcome_unknown": 1
          }
        }
      },
      "mock-private": {
        "driver": "mock",
        "visibility": "public",
        "allowPrivateUploadBeforeApproval": true,
        "parameters": {
          "stateDir": "@ROOT@/mock"
        }
      }
    },
    "defaults": {
      "requireApproval": true,
      "allowPrivateUploadBeforeApproval": false,
      "uploadResumable": true,
      "savePublicationRecord": true
    }
  }
}
