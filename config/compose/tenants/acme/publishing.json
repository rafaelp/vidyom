{
  "publishing": {
    "destinations": {
      "mock-main": {
        "driver": "mock",
        "visibility": "public",
        "parameters": { "stateDir": "/var/lib/vidyom/mock" }
      },
      "mock-flaky": {
        "driver": "mock",
        "visibility": "public",
        "parameters": { "stateDir": "/var/lib/vidyom/mock", "inject": { "outcome_unknown": 1 } }
      }
    },
    "defaults": {
      "requireApproval": true,
      "allowPrivateUploadBeforeApproval": false,
      "uploadResumable": true,
      "savePublicationRecord": true
    }
  }
}
