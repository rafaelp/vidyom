# The public library: Next.js reading one tenant's public.db read-only (D18, D34). It holds
# no address of the daemon. Mount the DIRECTORY holding public.db, never the single file:
# a rename does not propagate through a single-file bind mount, so a withdrawn video would
# keep being served.
# Build from the repository root: docker build -f deploy/Dockerfile.library .
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY library/package.json library/package-lock.json ./
RUN npm ci --no-audit --no-fund --quiet
COPY library/ ./
ENV NEXT_TELEMETRY_DISABLED=1 VIDYOM_LIBRARY_STANDALONE=1
RUN npm run build
RUN cp -r .next/static .next/standalone/.next/static && \
    if [ -d public ]; then cp -r public .next/standalone/public; fi

FROM node:22-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build /src/.next/standalone/ ./
RUN install -d -o 10001 -g 10001 -m 0755 /var/lib/vidyom/public
USER 10001:10001
EXPOSE 3000
CMD ["node", "server.js"]
